# FAIR4AI Agent - Environment Variables
# Copy this file to .env and add your actual API keys

# OpenAI API Key (for GPT models)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Azure OpenAI Configuration (for Azure-hosted GPT models)
# Get these from your Azure Portal: https://portal.azure.com
# Use either OPENAI_SUBSCRIPTION_KEY (standard Azure variable) or AZURE_OPENAI_API_KEY
OPENAI_SUBSCRIPTION_KEY=your-azure-subscription-key-here
# AZURE_OPENAI_API_KEY=your-azure-api-key-here  # Alternative to OPENAI_SUBSCRIPTION_KEY
OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/  # Alternative to OPENAI_ENDPOINT
OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name  # Alternative to OPENAI_DEPLOYMENT
OPENAI_API_VERSION=2024-08-01-preview
# AZURE_OPENAI_API_VERSION=2024-08-01-preview  # Alternative to OPENAI_API_VERSION

# Anthropic API Key (for Claude models)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Note: You only need ONE provider configured
# - For OpenAI: Set OPENAI_API_KEY and use --provider openai
# - For Azure: Set all AZURE_* variables and use --provider azure
# - For Anthropic: Set ANTHROPIC_API_KEY and use --provider anthropic
